[Unit]
Description=Ontoforge Webhook Worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ontoforge
Group=ontoforge
ExecStart=/usr/local/bin/ontoforge webhook-worker --server-config /etc/ontoforge/ontoforge-server.toml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
