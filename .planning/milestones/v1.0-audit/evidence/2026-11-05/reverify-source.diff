+        except Exception:
+            status = status or 1
+            print("evidence publication rejected", file=sys.stderr)
+        try:
+            cleanup_result = cleanup(state)
+            if baseline is not None:
+                after = snapshot()
+                cleanup_result["existing_containers_unchanged"] = all(after.get(k) == v for k, v in baseline.items())
