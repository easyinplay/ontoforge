// crates/ontoforge-engine/src/lib.rs
pub mod error; pub mod printer; pub mod sqlite; pub mod value;
pub use error::{EngineError, PrintError};
pub use printer::{Dialect, PrintedSql};
pub use value::{Column, PhysicalColumn, PhysicalType, Value};

#[derive(Debug, Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub struct TableRef { pub catalog: String, pub schema: String, pub table: String }
impl TableRef { pub fn sqlite_schema_name(&self) -> String /* "{catalog}__{schema}" */; }

#[derive(Debug, Clone)]
pub struct QueryContext { pub trace_token: String, pub client_tags: Vec<String>,
                          pub timeout: std::time::Duration, pub max_rows: usize, pub max_bytes: usize }
#[derive(Debug, Clone, PartialEq)]
pub struct QueryOutput { pub columns: Vec<Column>, pub rows: Vec<Vec<Value>>, pub truncated: bool }
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum EngineStatus { Available, Unavailable { reason: String } }

pub trait Engine {
    fn dialect(&self) -> Dialect;
    fn execute(&self, sql: &PrintedSql, ctx: &QueryContext)
        -> impl Future<Output = Result<QueryOutput, EngineError>> + Send;
    fn describe_table(&self, table: &TableRef, ctx: &QueryContext)
        -> impl Future<Output = Result<Option<Vec<PhysicalColumn>>, EngineError>> + Send;   // None = 表不存在
    fn status(&self) -> impl Future<Output = EngineStatus> + Send;
}
pub enum AnyEngine { Sqlite(sqlite::SqliteEngine) }      // 02-04 追加 Trino(trino::TrinoEngine)
impl Engine for AnyEngine { /* match 分发 */ }

// crates/ontoforge-engine/src/error.rs（thiserror）
pub enum EngineError {
    Unavailable { retryable: bool, reason: String }, Unauthorized { reason: String },
    Timeout { after_ms: u64 }, Cancelled, Query { error_name: String, message: String },
    Protocol(String), Print(PrintError), Config(String), Fixture(String),
}
impl EngineError { pub fn code(&self) -> &'static str; }  // ENGINE_UNAVAILABLE, ENGINE_UNAUTHORIZED, ENGINE_TIMEOUT,
                                                           // ENGINE_CANCELLED, ENGINE_QUERY_FAILED, ENGINE_PROTOCOL_ERROR,
                                                           // SQL_PRINT_ERROR, ENGINE_CONFIG_ERROR, ENGINE_FIXTURE_ERROR
pub enum PrintError { NulInString, EmptyIdentifier, NulInIdentifier, NonFiniteDouble,
                      InvalidDecimal(String), InvalidDate(String), InvalidTimestamp(String),
                      EmptyProjection, EmptyInList, EmptyBoolList }

// crates/ontoforge-engine/src/printer/{mod,ast,escape,dialect,sqlite_ddl}.rs
pub struct PrintedSql(String);           // 字段私有；fn new 为 pub(crate)；pub fn as_str(&self) -> &str
pub enum Dialect { Trino, Sqlite }
pub fn print_select(select: &ast::Select, dialect: Dialect) -> Result<PrintedSql, PrintError>;
pub(crate) fn quote_string(s: &str) -> Result<String, PrintError>;
pub(crate) fn quote_ident(s: &str) -> Result<String, PrintError>;
pub struct Select { pub projection: Vec<SelectItem>, pub from: Option<TableRef>, pub filter: Option<Expr>,
                    pub group_by: Vec<Expr>, pub having: Option<Expr>, pub order_by: Vec<OrderItem>, pub limit: Option<u64> }
pub struct SelectItem { pub expr: Expr, pub alias: Option<String> }
pub enum Expr { Column(String), Literal(Literal), CountStar, Aggregate { func: AggregateFunc, arg: Box<Expr> },
                Compare { left: Box<Expr>, op: CompareOp, right: Box<Expr> },
                InList { expr: Box<Expr>, list: Vec<Literal>, negated: bool },
                IsNull { expr: Box<Expr>, negated: bool }, And(Vec<Expr>), Or(Vec<Expr>), Not(Box<Expr>) }
pub enum Literal { Null, Boolean(bool), Long(i64), Double(f64), Decimal(String), String(String), Date(String), Timestamp(String) }
pub enum CompareOp { Eq, NotEq, Lt, LtEq, Gt, GtEq }
pub enum AggregateFunc { Count, Sum, Avg, Min, Max }
pub struct OrderItem { pub expr: Expr, pub descending: bool, pub nulls_first: bool }
pub mod sqlite_ddl {   // 只给 SQLite 替身用
    pub fn attach_memory(schema_name: &str) -> Result<PrintedSql, PrintError>;
    pub fn attach_file(path: &str, schema_name: &str) -> Result<PrintedSql, PrintError>;
    pub fn create_table(table: &TableRef, columns: &[(String, SqliteStorage)]) -> Result<PrintedSql, PrintError>;
    pub fn insert(table: &TableRef, columns: &[String]) -> Result<PrintedSql, PrintError>;   // VALUES (?1, ?2, ...)
    pub fn query_only() -> PrintedSql;                                                        // PRAGMA query_only = ON
    pub fn table_info() -> PrintedSql;           // SELECT name, type, "notnull" FROM pragma_table_info(?1, ?2)
    pub enum SqliteStorage { Text, Integer, Real }
}

// crates/ontoforge-engine/src/value.rs
pub enum PhysicalType { Boolean, Tinyint, Smallint, Integer, Bigint, Real, Double,
                        Decimal { precision: u8, scale: u8 }, Number, Varchar { length: Option<u32> },
                        Char { length: u32 }, Date, Timestamp { precision: u8, with_time_zone: bool },
                        Array(Box<PhysicalType>), Other(String) }
impl PhysicalType { pub fn parse(s: &str) -> Self; pub fn render(&self) -> String; }   // parse 永不失败，未知 → Other
pub struct PhysicalColumn { pub name: String, pub physical: PhysicalType, pub nullable: bool }
pub struct Column { pub name: String, pub physical: PhysicalType }
pub enum Value { Null, Boolean(bool), Long(i64), Double(f64), Decimal(String), String(String),
                 Date(String), Timestamp(String), TimestampTz(String), Array(Vec<Value>), Unsupported(serde_json::Value) }

// crates/ontoforge-engine/src/sqlite/mod.rs
pub struct SqliteEngine { /* tokio::sync::Mutex<sqlx::SqliteConnection> + 每张表的 PhysicalColumn 元数据 */ }
impl SqliteEngine { pub async fn in_memory() -> Result<Self, EngineError>; }
