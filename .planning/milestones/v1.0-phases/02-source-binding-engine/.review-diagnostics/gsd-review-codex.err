// crates/ontoforge-engine/src/bind_check.rs
pub enum DegradeReason { SourceSchemaDrift }
impl DegradeReason { pub fn code(&self) -> &'static str; }          // "SOURCE_SCHEMA_DRIFT"
pub enum TargetHealth { Healthy, Degraded { reason: DegradeReason, mismatches: Vec<Mismatch> } }
pub struct DriftReport { pub profile: ProfileName,
                         pub objects: BTreeMap<ObjectTypeName, TargetHealth>,
                         pub links: BTreeMap<LinkTypeName, TargetHealth> }
impl DriftReport { pub fn is_healthy(&self) -> bool; }
pub fn drift_report(ontology: &Ontology, profile: &ProfileName, described: &[DescribedBinding]) -> DriftReport;
pub async fn check_drift(engine: &AnyEngine, ontology: &Ontology, profile: &ProfileName, ctx: &QueryContext)
    -> Result<DriftReport, EngineError>;
```
