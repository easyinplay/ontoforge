// crates/ontoforge-engine/src/trino/classify.rs
pub(crate) enum Outcome { Page(QueryResults), Retry { after: Duration }, Fail(EngineError) }
pub(crate) fn classify_status(status: u16, retry_after: Option<&str>, is_post: bool, attempt: u32) -> Option<Outcome>;
pub(crate) fn classify_transport(err: &reqwest::Error, is_post: bool, attempt: u32) -> Outcome;
pub(crate) fn classify_query_error(error_name: &str, message: &str) -> EngineError;   // SERVER_STARTING_UP 等 → Unavailable
pub(crate) const MAX_RETRIES: u32 = 5;
// crates/ontoforge-engine/src/trino/cancel.rs
pub(crate) struct QueryGuard { /* client clone、认证、当前 nextUri、finished 标志 */ }
impl QueryGuard { pub(crate) fn advance(&mut self, next: Option<reqwest::Url>); pub(crate) fn finish(&mut self);
                  pub(crate) async fn cancel_now(&mut self); }
impl Drop for QueryGuard { /* 未完成且有 nextUri：Handle::try_current() 成功则 spawn DELETE，失败则放弃 */ }
