---
source: crates/ontoforge-storage/src/ddl.rs
expression: "aviation_ddl(Backend::Postgres, Some(\"ontoforge_edit\"))"
---
CREATE TABLE IF NOT EXISTS "ontoforge_edit"."of_obj_aircraft" ( "tail_number" text COLLATE "C" NOT NULL PRIMARY KEY, "in_service_since" date, "in_service_since__set" bool NOT NULL DEFAULT FALSE, "model" text COLLATE "C", "model__set" bool NOT NULL DEFAULT FALSE, "seat_capacity" integer, "seat_capacity__set" bool NOT NULL DEFAULT FALSE, "of_version" bigint NOT NULL DEFAULT 0, "of_deleted" bool NOT NULL DEFAULT FALSE, "of_released" bool NOT NULL DEFAULT FALSE, "of_def_version" bigint NOT NULL DEFAULT 0, "of_log_seq" bigint NULL );

CREATE TABLE IF NOT EXISTS "ontoforge_edit"."of_obj_airport" ( "code" text COLLATE "C" NOT NULL PRIMARY KEY, "city" text COLLATE "C", "city__set" bool NOT NULL DEFAULT FALSE, "country" text COLLATE "C", "country__set" bool NOT NULL DEFAULT FALSE, "location" jsonb, "location__set" bool NOT NULL DEFAULT FALSE, "name" text COLLATE "C", "name__set" bool NOT NULL DEFAULT FALSE, "of_version" bigint NOT NULL DEFAULT 0, "of_deleted" bool NOT NULL DEFAULT FALSE, "of_released" bool NOT NULL DEFAULT FALSE, "of_def_version" bigint NOT NULL DEFAULT 0, "of_log_seq" bigint NULL );

CREATE TABLE IF NOT EXISTS "ontoforge_edit"."of_obj_flight" ( "flight_id" text COLLATE "C" NOT NULL PRIMARY KEY, "aircraft_tail_number" text COLLATE "C", "aircraft_tail_number__set" bool NOT NULL DEFAULT FALSE, "arrival_airport_code" text COLLATE "C", "arrival_airport_code__set" bool NOT NULL DEFAULT FALSE, "delay_minutes" integer, "delay_minutes__set" bool NOT NULL DEFAULT FALSE, "departure_airport_code" text COLLATE "C", "departure_airport_code__set" bool NOT NULL DEFAULT FALSE, "flight_number" text COLLATE "C", "flight_number__set" bool NOT NULL DEFAULT FALSE, "scheduled_departure" timestamptz, "scheduled_departure__set" bool NOT NULL DEFAULT FALSE, "status" text COLLATE "C", "status__set" bool NOT NULL DEFAULT FALSE, "tags" text[], "tags__set" bool NOT NULL DEFAULT FALSE, "of_version" bigint NOT NULL DEFAULT 0, "of_deleted" bool NOT NULL DEFAULT FALSE, "of_released" bool NOT NULL DEFAULT FALSE, "of_def_version" bigint NOT NULL DEFAULT 0, "of_log_seq" bigint NULL );

CREATE INDEX IF NOT EXISTS "of_ix_of_obj_flight_status" ON "ontoforge_edit"."of_obj_flight" ("status");

CREATE TABLE IF NOT EXISTS "ontoforge_edit"."of_obj_maintenance_record" ( "record_id" text COLLATE "C" NOT NULL PRIMARY KEY, "aircraft_tail_number" text COLLATE "C", "aircraft_tail_number__set" bool NOT NULL DEFAULT FALSE, "cost" numeric(12, 2), "cost__set" bool NOT NULL DEFAULT FALSE, "performed_at" timestamptz, "performed_at__set" bool NOT NULL DEFAULT FALSE, "performed_by" text COLLATE "C", "performed_by__set" bool NOT NULL DEFAULT FALSE, "summary" text COLLATE "C", "summary__set" bool NOT NULL DEFAULT FALSE, "of_version" bigint NOT NULL DEFAULT 0, "of_deleted" bool NOT NULL DEFAULT FALSE, "of_released" bool NOT NULL DEFAULT FALSE, "of_def_version" bigint NOT NULL DEFAULT 0, "of_log_seq" bigint NULL );

CREATE UNIQUE INDEX IF NOT EXISTS "of_ux_of_obj_maintenance_record_aircraft_tail_number" ON "ontoforge_edit"."of_obj_maintenance_record" ("aircraft_tail_number") WHERE "aircraft_tail_number__set" AND (NOT "of_deleted");

CREATE TABLE IF NOT EXISTS "ontoforge_edit"."of_obj_pilot" ( "employee_id" text COLLATE "C" NOT NULL PRIMARY KEY, "flight_hours" double precision, "flight_hours__set" bool NOT NULL DEFAULT FALSE, "full_name" text COLLATE "C", "full_name__set" bool NOT NULL DEFAULT FALSE, "license_number" text COLLATE "C", "license_number__set" bool NOT NULL DEFAULT FALSE, "of_version" bigint NOT NULL DEFAULT 0, "of_deleted" bool NOT NULL DEFAULT FALSE, "of_released" bool NOT NULL DEFAULT FALSE, "of_def_version" bigint NOT NULL DEFAULT 0, "of_log_seq" bigint NULL );

CREATE TABLE IF NOT EXISTS "ontoforge_edit"."of_lnk_flight_crew" ( "a_pk" text COLLATE "C" NOT NULL, "b_pk" text COLLATE "C" NOT NULL, "of_version" bigint NOT NULL DEFAULT 0, "of_deleted" bool NOT NULL DEFAULT FALSE, "of_def_version" bigint NOT NULL DEFAULT 0, "of_log_seq" bigint NULL, PRIMARY KEY ("a_pk", "b_pk") );
