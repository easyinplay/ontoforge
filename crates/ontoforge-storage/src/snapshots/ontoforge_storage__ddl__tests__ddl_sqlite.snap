---
source: crates/ontoforge-storage/src/ddl.rs
expression: "aviation_ddl(Backend::Sqlite, None)"
---
CREATE TABLE IF NOT EXISTS "of_obj_aircraft" ( "tail_number" text NOT NULL PRIMARY KEY, "in_service_since" text, "in_service_since__set" integer NOT NULL DEFAULT 0, "model" text, "model__set" integer NOT NULL DEFAULT 0, "seat_capacity" integer, "seat_capacity__set" integer NOT NULL DEFAULT 0, "of_version" integer NOT NULL DEFAULT 0, "of_deleted" integer NOT NULL DEFAULT 0, "of_released" integer NOT NULL DEFAULT 0, "of_def_version" integer NOT NULL DEFAULT 0, "of_log_seq" integer NULL );

CREATE TABLE IF NOT EXISTS "of_obj_airport" ( "code" text NOT NULL PRIMARY KEY, "city" text, "city__set" integer NOT NULL DEFAULT 0, "country" text, "country__set" integer NOT NULL DEFAULT 0, "location" text, "location__set" integer NOT NULL DEFAULT 0, "name" text, "name__set" integer NOT NULL DEFAULT 0, "of_version" integer NOT NULL DEFAULT 0, "of_deleted" integer NOT NULL DEFAULT 0, "of_released" integer NOT NULL DEFAULT 0, "of_def_version" integer NOT NULL DEFAULT 0, "of_log_seq" integer NULL );

CREATE TABLE IF NOT EXISTS "of_obj_flight" ( "flight_id" text NOT NULL PRIMARY KEY, "aircraft_tail_number" text, "aircraft_tail_number__set" integer NOT NULL DEFAULT 0, "arrival_airport_code" text, "arrival_airport_code__set" integer NOT NULL DEFAULT 0, "delay_minutes" integer, "delay_minutes__set" integer NOT NULL DEFAULT 0, "departure_airport_code" text, "departure_airport_code__set" integer NOT NULL DEFAULT 0, "flight_number" text, "flight_number__set" integer NOT NULL DEFAULT 0, "scheduled_departure" text COLLATE ontoforge_timestamp, "scheduled_departure__set" integer NOT NULL DEFAULT 0, "status" text, "status__set" integer NOT NULL DEFAULT 0, "tags" text, "tags__set" integer NOT NULL DEFAULT 0, "of_version" integer NOT NULL DEFAULT 0, "of_deleted" integer NOT NULL DEFAULT 0, "of_released" integer NOT NULL DEFAULT 0, "of_def_version" integer NOT NULL DEFAULT 0, "of_log_seq" integer NULL );

CREATE INDEX IF NOT EXISTS "of_ix_of_obj_flight_status" ON "of_obj_flight" ("status");

CREATE TABLE IF NOT EXISTS "of_obj_maintenance_record" ( "record_id" text NOT NULL PRIMARY KEY, "aircraft_tail_number" text, "aircraft_tail_number__set" integer NOT NULL DEFAULT 0, "cost" text COLLATE ontoforge_decimal, "cost__set" integer NOT NULL DEFAULT 0, "performed_at" text COLLATE ontoforge_timestamp, "performed_at__set" integer NOT NULL DEFAULT 0, "performed_by" text, "performed_by__set" integer NOT NULL DEFAULT 0, "summary" text, "summary__set" integer NOT NULL DEFAULT 0, "of_version" integer NOT NULL DEFAULT 0, "of_deleted" integer NOT NULL DEFAULT 0, "of_released" integer NOT NULL DEFAULT 0, "of_def_version" integer NOT NULL DEFAULT 0, "of_log_seq" integer NULL );

CREATE UNIQUE INDEX IF NOT EXISTS "of_ux_of_obj_maintenance_record_aircraft_tail_number" ON "of_obj_maintenance_record" ("aircraft_tail_number") WHERE "aircraft_tail_number__set" = 1 AND "of_deleted" = 0;

CREATE TABLE IF NOT EXISTS "of_obj_pilot" ( "employee_id" text NOT NULL PRIMARY KEY, "flight_hours" double, "flight_hours__set" integer NOT NULL DEFAULT 0, "full_name" text, "full_name__set" integer NOT NULL DEFAULT 0, "license_number" text, "license_number__set" integer NOT NULL DEFAULT 0, "of_version" integer NOT NULL DEFAULT 0, "of_deleted" integer NOT NULL DEFAULT 0, "of_released" integer NOT NULL DEFAULT 0, "of_def_version" integer NOT NULL DEFAULT 0, "of_log_seq" integer NULL );

CREATE TABLE IF NOT EXISTS "of_lnk_flight_crew" ( "a_pk" text NOT NULL, "b_pk" text NOT NULL, "of_version" integer NOT NULL DEFAULT 0, "of_deleted" integer NOT NULL DEFAULT 0, "of_def_version" integer NOT NULL DEFAULT 0, "of_log_seq" integer NULL, PRIMARY KEY ("a_pk", "b_pk") );
